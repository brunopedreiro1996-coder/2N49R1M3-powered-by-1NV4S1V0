        "import gmpy2\n",
        "from gmpy2 import mpz\n",
        "\n",
        "def fast_micelial_repair(df):\n",
        "    print('⚙️ Iniciando Reparo de Linhagem em Larga Escala...')\n",
        "\n",
        "    # Separar Elites como potenciais pais\n",
        "    elites = df[df['certified'] == True].copy()\n",
        "    elites['mpz_v'] = elites['v'].apply(mpz)\n",
        "\n",
        "    # Mapeamento para busca rápida\n",
        "    elite_map = {row['v']: row['mpz_v'] for _, row in elites.iterrows()}\n",
        "    anchor_ked16 = mpz(2)**16\n",
        "\n",
        "    def find_parent(child_str):\n",
        "        child_val = mpz(child_str)\n",
        "        target = child_val - 1\n",
        "        for p_str, p_val in elite_map.items():\n",
        "            if child_val > p_val:\n",
        "                if target % (p_val * anchor_ked16) == 0:\n",
        "                    return p_str\n",
        "        return None\n",
        "\n",
        "    # Aplicar apenas em órfãos\n",
        "    orphans_mask = df['parent'].isna() | (df['parent'] == 'unknown')\n",
        "    df.loc[orphans_mask, 'new_parent'] = df.loc[orphans_mask, 'v'].apply(find_parent)\n",
        "\n",
        "    # Atualizar\n",
        "    repaired = df['new_parent'].notna().sum()\n",
        "    df.loc[df['new_parent'].notna(), 'parent'] = df['new_parent']\n",
        "    df.loc[df['new_parent'].notna(), 'type'] = 'recovered_ked16_lineage'\n",
        "\n",
        "    print(f'✅ Reparo concluído: {repaired} novos vínculos estabelecidos.')\n",
        "    return df.drop(columns=['new_parent'])\n",
        "\n",
        "# Executar reparo na malha unificada\n",
        "df_repaired = fast_micelial_repair(df_master)\n",
        "\n",
        "# Salvar estado final e sincronizar com Drive\n",
        "final_data = df_repaired.to_dict(orient='records')\n",
        "with open('cpi_storage.json', 'w') as f:\n",
        "    json.dump(final_data, f, indent=4)\n",
        "\n",
        "shutil.copy('cpi_storage.json', drive_path)\n",
        "print('💾 Malha unificada e reparada salva no Google Drive.')"
