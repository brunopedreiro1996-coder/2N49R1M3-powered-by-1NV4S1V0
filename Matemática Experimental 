        "base_3_600 = mpz(3)**600\n",
        "# Fator conhecido F = primorial * base_3 para garantir F > sqrt(N)\n",
        "F_conhecido = get_primorial_py(10) * base_3_600\n",
        "seed_k321 = (321 * F_conhecido) + 1\n",
        "\n",
        "verify_elite_node_pocklington(str(seed_k321), str(F_conhecido))"
