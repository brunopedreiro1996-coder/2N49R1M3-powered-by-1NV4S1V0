        "import json\n",
        "import gmpy2\n",
        "from gmpy2 import mpz\n",
        "import os\n",
        "\n",
        "def micelial_lineage_repair(storage_file='cpi_storage.json', drive_target='/content/drive/MyDrive/2N49R1M3_Project/cpi_storage.json'):\n",
        "    with open(storage_file, 'r') as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    # Indexar sementes por magnitude para busca inteligente\n",
        "    seeds = sorted([mpz(e['v']) for e in data if e.get('certified') == True])\n",
        "    repaired = 0\n",
        "    batch_limit = 50000\n",
        "\n",
        "    print(f\"🍄 Iniciando Reparo Micelial (Profundidade 2)...\")\n",
        "\n",
        "    for i, entry in enumerate(data):\n",
        "        if entry.get('parent') in [None, 'unknown', 'NaN']:\n",
        "            c_val = mpz(entry['v'])\n",
        "            # Tentar encontrar semente que satisfaça o torque k-residencial\n",
        "            for s_val in seeds:\n",
        "                if c_val > s_val:\n",
        "                    diff = c_val - 1\n",
        "                    if diff % s_val == 0:\n",
        "                        entry['parent'] = str(s_val)\n",
        "                        entry['type'] = 'micelial_torque_recovery'\n",
        "                        repaired += 1\n",
        "                        break\n",
        "\n",
        "        if i > 0 and i % batch_limit == 0:\n",
        "            print(f\"💾 Salvando checkpoint: {i} processados...\")\n",
        "            with open(storage_file, 'w') as f:\n",
        "                json.dump(data, f, indent=4)\n",
        "            !cp {storage_file} \"{drive_target}\"\n",
        "\n",
        "    with open(storage_file, 'w') as f:\n",
        "        json.dump(data, f, indent=4)\n",
        "    !cp {storage_file} \"{drive_target}\"\n",
        "    print(f\"✅ Fim do ciclo. Vínculos recuperados: {repaired}\")\n",
        "\n",
        "micelial_lineage_repair()"
