        "    hits = []\n",
        "    start_time = time.time()\n",
        "\n",
        "    # Varredura de vizinhança na malha 30k\n",
        "    for i in range(1, iterations * 30, 2):\n",
        "        candidate = base + i\n",
        "        # Verifica a 'limpeza' (assinatura de zeros nos bits baixos do P-1)\n",
        "        # No caso KED-16, p-1 ou p+1 deve ser altamente divisível por 2\n",
        "        if gmpy2.is_prime(candidate):\n",
        "            clarity = gmpy2.bit_scan1(candidate - 1)\n",
