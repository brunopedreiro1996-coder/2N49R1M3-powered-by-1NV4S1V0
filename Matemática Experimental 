        "        std::unique_lock<std::mutex> lock(mutex_);\n",
        "        cond_.wait(lock, [this] { return !queue_.empty(); });\n",
        "        value = std::move(queue_.front());\n",
        "        queue_.pop();\n",
        "        return true;\n",
        "    }\n",
