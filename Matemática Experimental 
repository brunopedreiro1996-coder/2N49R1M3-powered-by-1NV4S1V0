      "source": [
        "# @title\n",
        "import json\n",
        "import pandas as pd\n",
        "from collections import defaultdict\n",
        "\n",
        "try:\n",
        "    with open('cpi_storage.json', 'r') as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    # Agrupando por parentesco\n",
        "    lineage = defaultdict(list)\n",
        "    for entry in data:\n",
        "        parent = entry.get('parent', 'Raiz')\n",
        "        child = entry.get('v')\n",
        "        h_type = entry.get('type')\n",
        "        mag = entry.get('mag')\n",
        "        lineage[parent].append(f\"{child[:10]}... (Mag: {mag})\")\n",
        "\n",
        "    # Exibindo resumo das linhagens mais férteis\n",
        "    summary = []\n",
        "    for parent, children in lineage.items():\n",
        "        summary.append({\"Parent (Semente)\": parent, \"Descendentes Encontrados\": len(children)})\n",
        "\n",
        "    df_lineage = pd.DataFrame(summary).sort_values(by=\"Descendentes Encontrados\", ascending=False)\n",
        "    display(df_lineage.head(10))\n",
        "\n",
        "except FileNotFoundError:\n",
        "    print(\"Arquivo cpi_storage.json não encontrado. Execute o motor C++ acima para gerar dados.\")"
