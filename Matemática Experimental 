        "import json\n",
        "import os\n",
        "import pandas as pd\n",
        "import gmpy2\n",
        "from gmpy2 import mpz\n",
        "\n",
        "def deep_lineage_repair(db_path='/content/drive/MyDrive/2N49R1M3_Project/cpi_storage.json'):\n",
        "    if not os.path.exists(db_path):\n",
        "        print(\"❌ Erro: Banco de dados não encontrado no Drive.\")\n",
        "        return\n",
        "\n",
        "    print(f\"⚙️ Carregando Malha para Reparo de Linhagem: {db_path}\")\n",
        "    with open(db_path, 'r') as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    df = pd.DataFrame(data)\n",
        "\n",
        "    # Identificar Sementes Elite (Certificadas) como potenciais pais\n",
        "    seeds = df[df['certified'] == True].copy()\n",
        "    seeds['mpz_v'] = seeds['v'].apply(mpz)\n",
        "\n",
        "    # Identificar Órfãos\n",
        "    orphans_mask = df['parent'].isna() | (df['parent'] == 'unknown')\n",
        "    orphans_indices = df[orphans_mask].index\n",
        "\n",
        "    print(f\"🔍 Analisando {len(seeds)} sementes contra {len(orphans_indices)} órfãos...\")\n",
        "\n",
        "    repaired_count = 0\n",
        "    anchor_ked16 = mpz(2)**16\n",
        "\n",
        "    # Tentativa de reconstrução por Torque KED-16\n",
        "    for idx in orphans_indices:\n",
        "        child_val = mpz(df.at[idx, 'v'])\n",
        "        target = child_val - 1\n",
        "\n",
        "        for _, seed_row in seeds.iterrows():\n",
        "            s_val = seed_row['mpz_v']\n",
        "            if child_val > s_val:\n",
        "                # P = (s * 2^16 * k) + 1 => (P-1) deve ser divisível por (s * 2^16)\n",
        "                if target % (s_val * anchor_ked16) == 0:\n",
        "                    df.at[idx, 'parent'] = seed_row['v']\n",
        "                    df.at[idx, 'type'] = 'recovered_ked16_lineage'\n",
        "                    repaired_count += 1\n",
        "                    break\n",
        "\n",
        "    if repaired_count > 0:\n",
        "        print(f\"✅ Sucesso! {repaired_count} vínculos de parentesco restaurados.\")\n",
        "        # Salvar de volta para o Drive\n",
        "        updated_data = df.to_dict(orient='records')\n",
        "        with open(db_path, 'w') as f:\n",
        "            json.dump(updated_data, f, indent=4)\n",
        "        print(\"💾 Banco de dados atualizado no Drive.\")\n",
        "    else:\n",
        "        print(\"ℹ️ Nenhuma nova linhagem detectada com a profundidade KED-16 atual.\")\n",
        "\n",
        "deep_lineage_repair()"
      ],
