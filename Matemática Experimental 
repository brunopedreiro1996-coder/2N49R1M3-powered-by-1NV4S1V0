        "# @title 🛠️ Reparo de Linhagem com Sincronia KED-16\n",
        "import json\n",
        "import gmpy2\n",
        "from gmpy2 import mpz\n",
        "import os\n",
        "\n",
        "def repair_with_ked16(storage_file='cpi_storage.json'):\n",
        "    if not os.path.exists(storage_file):\n",
        "        print(\"❌ Arquivo não encontrado.\")\n",
        "        return\n",
        "\n",
        "    with open(storage_file, 'r') as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    print(f\"🔍 Aplicando Filtro KED-16 em {len(data)} registros...\")\n",
        "\n",
        "    # Âncora KED-16: 65536\n",
        "    anchor_ked = mpz(2)**16\n",
        "    seeds = {mpz(entry['v']): entry['v'] for entry in data if len(entry['v']) < 100}\n",
        "    repaired = 0\n",
        "\n",
        "    for entry in data:\n",
        "        if entry.get('parent') in [None, 'unknown', 'NaN']:\n",
        "            p = mpz(entry['v'])\n",
        "            for s_val, s_str in seeds.items():\n",
        "                # Verifica se o primo descende da semente via canal KED-16\n",
        "                # P = (s * 2^16 * k) + 1\n",
        "                target = p - 1\n",
        "                if target > 0 and target % (s_val * anchor_ked) == 0:\n",
        "                    entry['parent'] = s_str\n",
        "                    entry['type'] = 'ked16_resonance_link'\n",
        "                    entry['certified'] = True\n",
        "                    repaired += 1\n",
        "                    break\n",
        "\n",
        "    if repaired > 0:\n",
        "        print(f\"✅ {repaired} novos vínculos estabelecidos via Sincronia KED-16.\")\n",
        "        with open(storage_file, 'w') as f:\n",
        "            json.dump(data, f, indent=4)\n",
        "        os.system(f'cp {storage_file} \"/content/drive/My Drive/2N49R1M3_Project/cpi_storage.json\"')\n",
        "    else:\n",
        "        print(\"ℹ️ A malha atual está consistente ou exige maior profundidade de sementes.\")\n",
        "\n",
        "repair_with_ked16('cpi_storage.json')"
      ]
