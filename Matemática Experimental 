        "# @title\n",
        "import gmpy2\n",
        "import pandas as pd\n",
        "import json\n",
        "import os\n",
        "from tqdm.auto import tqdm\n",
        "import shutil\n",
        "\n",
        "def run_full_database_repair(file_path='cpi_storage.json'):\n",
        "    if not os.path.exists(file_path):\n",
        "        return \"Arquivo não encontrado.\"\n",
        "\n",
        "    print(\"📂 Carregando base de dados mestre...\")\n",
        "    with open(file_path, 'r') as f:\n",
        "        data = json.load(f)\n",
        "    df = pd.DataFrame(data)\n",
        "\n",
        "    if 'parent' not in df.columns:\n",
        "        df['parent'] = None\n",
        "\n",
        "    # Indexing small elite/seed nodes for fast lookup\n",
        "    seeds_df = df[df['mag'].astype(float) < 100].copy()\n",
        "    seed_items = {str(row['v']): gmpy2.mpz(str(row['v'])) for _, row in seeds_df.iterrows()}\n",
        "    seed_list = list(seed_items.items())\n",
        "\n",
        "    # Identifying remaining orphans\n",
        "    is_orphan = df['parent'].isna() | (df['parent'] == \"\") | (df['parent'] == \"None\") | (df['parent'] == \"unknown\")\n",
        "    orphans_indices = df[is_orphan].index\n",
        "\n",
        "    if len(orphans_indices) == 0:\n",
        "        return \"✅ Todos os registros já possuem linhagem mapeada.\"\n",
        "\n",
        "    print(f\"🚀 Iniciando Processamento Global: {len(orphans_indices):,} órfãos detectados.\")\n",
        "    repaired = 0\n",
        "\n",
        "    try:\n",
        "        for idx in tqdm(orphans_indices):\n",
        "            child_v = gmpy2.mpz(str(df.at[idx, 'v']))\n",
        "\n",
        "            for p_str, p_val in seed_list:\n",
        "                if child_v <= p_val: continue\n",
        "\n",
        "                # Optimized Divisibility and Expansion Check\n",
        "                rem = child_v % p_val\n",
        "\n",
        "                # Case 1: Direct Multiple or P-1 relation\n",
        "                if rem == 0 or rem == 1:\n",
        "                    df.at[idx, 'parent'] = p_str\n",
        "                    df.at[idx, 'type'] = 'optimized_residue_link'\n",
        "                    repaired += 1\n",
        "                    break\n",
        "\n",
        "                # Case 2: Power of 2 quotient (KED Logic)\n",
        "                if rem == 0:\n",
        "                    q = child_v // p_val\n",
        "                    if q > 0 and (q & (q - 1) == 0):\n",
        "                        df.at[idx, 'parent'] = p_str\n",
        "                        df.at[idx, 'type'] = 'power_2_expansion'\n",
        "                        repaired += 1\n",
        "                        break\n",
        "\n",
        "            # Periodic checkpoint saving\n",
        "            if repaired % 25000 == 0 and repaired > 0:\n",
        "                with open(file_path, 'w') as f:\n",
        "                    json.dump(df.to_dict('records'), f, indent=4)\n",
        "\n",
        "    except KeyboardInterrupt:\n",
        "        print(\"\\n⚠️ Interrupção detectada. Salvando progresso parcial...\")\n",
        "\n",
        "    # Final save and sync to Drive\n",
        "    with open(file_path, 'w') as f:\n",
        "        json.dump(df.to_dict('records'), f, indent=4)\n",
        "\n",
        "    drive_path = '/content/drive/MyDrive/2N49R1M3_Project/cpi_storage.json'\n",
        "    shutil.copy(file_path, drive_path)\n",
