        "# @title\n",
        "%%writefile ked_polarity_validator.cpp\n",
        "#include <iostream>\n",
        "#include <gmpxx.h>\n",
        "#include <vector>\n",
        "#include <string>\n",
        "\n",
        "struct PolarityReport {\n",
        "    mpz_class candidate;\n",
        "    int resonance_bits;\n",
        "    bool is_prime_real;\n",
        "    std::string status;\n",
        "};\n",
        "\n",
        "PolarityReport audit_polarity(mpz_class anchor, int p_small) {\n",
        "    PolarityReport report;\n",
        "    report.candidate = anchor + p_small;\n",
        "\n",
        "    // Análise de Polaridade: (P - p_small) deve revelar a pureza da âncora\n",
        "    mpz_class body = report.candidate - p_small;\n",
        "    report.resonance_bits = (body == 0) ? 0 : mpz_scan1(body.get_mpz_t(), 0);\n",
        "\n",
        "    // Verificação de Primalidade Real (Miller-Rabin)\n",
        "    int check = mpz_probab_prime_p(report.candidate.get_mpz_t(), 25);\n",
        "    report.is_prime_real = (check > 0);\n",
        "\n",
        "    if (report.is_prime_real) {\n",
        "        report.status = (report.resonance_bits >= 16) ? \"[KED-16 SYNC]\" : \"[LOW RESONANCE]\";\n",
        "    } else {\n",
        "        report.status = \"[MIMETIC/COMPOSITE]\";\n",
        "    }\n",
        "\n",
        "    return report;\n",
        "}\n",
        "\n",
        "int main() {\n",
        "    // Simulação de Âncora de Magnitude (ex: 2^1024 para teste de 300+ dígitos)\n",
        "    mpz_class magnitude_anchor;\n",
        "    mpz_pow_ui(magnitude_anchor.get_mpz_t(), mpz_class(2).get_mpz_t(), 1024);\n",
        "\n",
        "    std::vector<int> p_seeds = {3, 7, 11, 13, 17, 19, 23, 29};\n",
        "\n",
        "    std::cout << \"--- Relatório de Polaridade e Ressonância KED ---\" << std::endl;\n",
        "    std::cout << \"Magnitude da Âncora: ~308 dígitos decimais\" << std::endl << std::endl;\n",
        "\n",
        "    for (int ps : p_seeds) {\n",
        "        PolarityReport r = audit_polarity(magnitude_anchor, ps);\n",
        "        std::cout << \"Semente: \" << ps << \" | Bits: \" << r.resonance_bits\n",
        "                  << \" | \" << r.status << std::endl;\n",
        "        if (r.is_prime_real) {\n",
        "            std::cout << \"  -> Valor (início): \" << r.candidate.get_str().substr(0, 40) << \"...\" << std::endl;\n",
        "        }\n",
        "    }\n",
        "\n",
        "    return 0;\n",
        "}\n"
