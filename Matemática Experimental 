        "# @title 🚀 Iniciando Alvo 1000-D (Sincronia Simbiótica)\n",
        "import json\n",
        "import os\n",
        "\n",
        "def prepare_1000d_targets(storage_file='cpi_storage.json'):\n",
        "    if not os.path.exists(storage_file):\n",
        "        return\n",
        "\n",
        "    with open(storage_file, 'r') as f:\n",
        "        data = json.load(f)\n",
        "\n",
        "    bins = {}\n",
        "    for entry in data:\n",
        "        mag = len(entry['v'])\n",
        "        if mag not in bins: bins[mag] = []\n",
        "        bins[mag].append(entry['v'])\n",
        "\n",
        "    print(\"--- Planejamento de Expansão 1000-D ---\")\n",
        "    target = 1000\n",
        "    found_pairs = False\n",
        "\n",
        "    for m in sorted(bins.keys()):\n",
        "        complement = target - m\n",
        "        if complement in bins and m <= complement:\n",
        "            print(f\"💎 Par Simbiótico Ideal: {m} dgts + {complement} dgts\")\n",
        "            print(f\"   Semente A: {bins[m][0][:20]}...\")\n",
        "            print(f\"   Semente B: {bins[complement][0][:20]}...\")\n",
        "            found_pairs = True\n",
        "            break\n",
        "\n",
        "    if not found_pairs:\n",
        "        print(\"⚠️ Nenhum par direto de 1000-dgts encontrado. Usando Expansão por Oitava (2^E).\")\n",
        "        # Seleciona a maior semente disponível para salto\n",
        "        max_mag = max(bins.keys())\n",
        "        best_seed = bins[max_mag][0]\n",
        "        needed_bits = int((1000 - max_mag) * 3.322) # log2(10)\n",
        "        print(f\"🔥 Recomendação: Semente de {max_mag} dgts com Salto E ≈ {needed_bits}\")\n",
        "\n",
        "prepare_1000d_targets()"
      ]
