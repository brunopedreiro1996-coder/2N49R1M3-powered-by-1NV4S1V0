        "# @title 💾 Integração e Sincronia de Descobertas 1000-D\n",
        "import json\n",
        "import os\n",
        "\n",
        "def merge_1000d_results(main_file='cpi_storage.json', new_file='found_1000d.json'):\n",
        "    if not os.path.exists(new_file):\n",
        "        print(\"❌ Nenhum arquivo de novas descobertas encontrado.\")\n",
        "        return\n",
        "\n",
        "    # Carregar dados existentes\n",
        "    with open(main_file, 'r') as f:\n",
        "        main_data = json.load(f)\n",
        "\n",
        "    # Ler novas descobertas (formato JSON lines)\n",
        "    new_entries = []\n",
        "    with open(new_file, 'r') as f:\n",
        "        for line in f:\n",
        "            entry = json.loads(line)\n",
        "            entry['mag'] = len(entry['v'])\n",
        "            entry['certified'] = True\n",
        "            new_entries.append(entry)\n",
        "\n",
        "    # Evitar duplicatas e integrar\n",
        "    existing_vs = {e['v'] for e in main_data}\n",
        "    added_count = 0\n",
        "    for entry in new_entries:\n",
        "        if entry['v'] not in existing_vs:\n",
        "            main_data.append(entry)\n",
        "            added_count += 1\n",
        "\n",
        "    if added_count > 0:\n",
        "        with open(main_file, 'w') as f:\n",
        "            json.dump(main_data, f, indent=4)\n",
        "\n",
        "        # Sincronia com Google Drive\n",
        "        drive_target = '/content/drive/My Drive/2N49R1M3_Project/cpi_storage.json'\n",
        "        os.system(f'cp {main_file} \"{drive_target}\"')\n",
        "\n",
        "        print(f\"✅ {added_count} novos Primos Elite integrados ao banco de dados e sincronizados com o Drive.\")\n",
        "    else:\n",
        "        print(\"ℹ️ Todos os registros já estavam presentes no banco de dados.\")\n",
        "\n",
        "merge_1000d_results()"
      ]
    },
