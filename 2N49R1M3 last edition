        "### 7.33. Visualiza&ccedil;&atilde;o do Corredor de Resson&acirc;ncia\n",
        "\n",
        "Plotamos a raz&atilde;o $q/p$ dos hits encontrados para verificar a estabilidade do atrator em rela&ccedil;&atilde;o a $1.666$ ($1 + 2/3$)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 403
        },
        "id": "5cb1eadd",
        "outputId": "0c581f78-584a-41d5-a553-97614b984224"
      },
      "source": [
        "import gmpy2\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Re-generating df_phi in global scope for visualization\n",
        "def get_phi_data(p_start, iterations=300):\n",
        "    results = []\n",
        "    phi = (1 + 5**0.5) / 2\n",
        "    p = gmpy2.next_prime(p_start)\n",
        "    for _ in range(iterations):\n",
        "        q = gmpy2.next_prime(p)\n",
        "        N = p * q\n",
        "        cand = N + (q**2 - p**2) - (q - p)\n",
        "        if gmpy2.is_prime(int(cand)):\n",
        "            ratio = float(q) / float(p)\n",
        "            results.append({\n",
        "                \"Ratio_qp\": ratio,\n",
        "                \"Dist_Phi\": abs(ratio - phi),\n",
        "                \"Dist_2/3\": abs(ratio - (1.666666))\n",
        "            })\n",
        "        p = q\n",
        "    return pd.DataFrame(results)\n",
        "\n",
        "df_phi = get_phi_data(1000, 300)\n",
        "\n",
        "if not df_phi.empty:\n",
        "    plt.figure(figsize=(12, 5))\n",
        "    plt.plot(df_phi.index, df_phi['Ratio_qp'], 'go-', label='Razão q/p (Hits)')\n",
        "    plt.axhline(y=1.666666, color='r', linestyle='--', label='Atrator 2/3 (1.666...)')\n",
        "    plt.axhline(y=1.618033, color='orange', linestyle=':', label='Golden Ratio (1.618)')\n",
        "    plt.title(\"Estabilidade Geométrica dos Primos Descobertos\")\n",
        "    plt.xlabel(\"Hit Index\")\n",
        "    plt.ylabel(\"Razão q/p\")\n",
        "    plt.legend()\n",
        "    plt.grid(alpha=0.3)\n",
        "    plt.show()\n",
        "    print(f\"Desvio Padrão da Razão: {df_phi['Ratio_qp'].std():.8f}\")\n",
        "else:\n",
        "    print(\"Nenhum hit encontrado para gerar o gráfico.\")"
