        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "def test_progression_hypothesis(x_base, primorial=210, steps=10):\n",
        "    results = []\n",
        "    interval = x_base * primorial\n",
        "\n",
        "    print(f'--- Progression Hypothesis Test ---')\n",
        "    print(f'Base: {x_base} | Primorial: {primorial} | Interval: {interval}')\n",
        "\n",
        "    for i in range(steps):\n",
        "        anchor = x_base + (i * interval)\n",
        "        # Local window of size 'primorial' to check one full cycle\n",
        "        window = np.arange(anchor, anchor + primorial)\n",
        "        mask = (window % 2 != 0) & (window % 3 != 0) & (window % 5 != 0) & (window % 7 != 0)\n",
        "        local_hits = window[mask]\n",
        "        density = len(local_hits) / primorial\n",
        "\n",
        "        results.append({\n",
        "            'step': i,\n",
        "            'anchor': anchor,\n",
        "            'local_density': round(density, 6),\n",
        "            'diff_from_theory': round(density - (48/210), 6)\n",
        "        })\n",
        "\n",
        "    df_progression = pd.DataFrame(results)\n",
        "    display(df_progression)\n",
        "    return df_progression\n",
