      "source": [
        "import gmpy2\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def audit_primorial_cycle(p_base, neighbor_range=50):\n",
        "    saturation_point = p_base**2\n",
        "    results = []\n",
        "    q = p_base\n",
        "\n",
        "    print(f'--- Primorial Audit: Base {p_base} (Saturation: {saturation_point}) ---')\n",
        "\n",
        "    for _ in range(neighbor_range):\n",
        "        q = int(gmpy2.next_prime(q))\n",
        "        N = p_base * q\n",
        "        # Formula: P = N + (q - p_base)\n",
        "        cand = N + (q - p_base)\n",
        "        is_prime = gmpy2.is_prime(cand)\n",
        "\n",
        "        results.append({\n",
        "            'q': q,\n",
        "            'N': N,\n",
        "            'Above_Saturation': N > saturation_point,\n",
        "            'Candidate': cand,\n",
        "            'Is_Prime': is_prime,\n",
        "            'Gap_to_Sat': N - saturation_point\n",
        "        })\n",
        "\n",
        "    df = pd.DataFrame(results)\n",
        "    summary = df.groupby('Above_Saturation')['Is_Prime'].mean() * 100\n",
        "    print('\\nSuccess Rate (%) vs Saturation:')\n",
        "    print(summary)\n",
        "    return df\n",
        "\n",
        "# Auditing for p=7 (Saturation 49) and p=13 (Saturation 169)\n",
        "df_audit_7 = audit_primorial_cycle(7, 30)\n",
        "display(df_audit_7.head(10))\n",
        "\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.scatter(df_audit_7['N'], df_audit_7['Is_Prime'].astype(int), c=df_audit_7['Above_Saturation'], cmap='coolwarm')\n",
        "plt.axvline(x=49, color='red', linestyle='--', label='Saturation Point (p^2)')\n",
        "plt.title('Primality Hits vs Primorial Saturation (p=7)')\n",
        "plt.xlabel('Anchor N')\n",
        "plt.ylabel('Hit (1=Prime, 0=Composite)')\n",
        "plt.legend()\n",
        "plt.show()"
      ],
