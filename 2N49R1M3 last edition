      "source": [
        "import gmpy2\n",
        "import pandas as pd\n",
        "\n",
        "def analyze_coprime_density(p, q, search_range=50):\n",
        "    N = p * q\n",
        "    hits = []\n",
        "\n",
        "    print(f\"Analisando Âncora: {N} (Fatores: {p}, {q})\")\n",
        "\n",
        "    for delta in range(1, search_range + 1):\n",
        "        # Garantir coprimatidade: Delta não pode ser divisível por p ou q\n",
        "        if delta % p != 0 and delta % q != 0:\n",
        "            for op in [1, -1]:\n",
        "                cand = N + (delta * op)\n",
        "                if gmpy2.is_prime(cand):\n",
        "                    hits.append({\"Delta\": delta * op, \"Prime\": int(cand)})\n",
        "\n",
        "    df_hits = pd.DataFrame(hits)\n",
        "    if not df_hits.empty:\n",
        "        print(f\"Encontrados {len(df_hits)} primos na vizinhança coprima.\")\n",
        "        display(df_hits)\n",
        "    else:\n",
        "        print(\"Nenhum primo encontrado nesta vizinhança com os critérios de coprimatidade.\")\n",
        "\n",
        "# Testando com fatores de magnitude média para observar a dispersão\n",
        "analyze_coprime_density(17, 19, 100)"
