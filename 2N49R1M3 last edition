        "### 7.22. Auditoria de Transição: O Atrator 0.666 (2/3)\n",
        "\n",
        "Vamos testar a hipótese de que o erro de reconstrução $E = |N - \\sqrt{N^2 - \\Delta_q}|$ normalizado pelo termo de curvatura linear $\\frac{\\Delta_q}{2N}$ apresenta uma transição harmônica em magnitudes específicas."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 516
        },
        "id": "b11b866c",
        "outputId": "900f186e-7917-4e15-9bc6-1e54a535fda3"
      },
      "source": [
        "import gmpy2\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def plot_resonance_landscape(start_mag, end_mag):\n",
        "    results = []\n",
        "    print(f\"Mapeando paisagem de ressonância de 10^{start_mag} a 10^{end_mag}...\")\n",
        "\n",
        "    for mag in range(start_mag, end_mag + 1):\n",
        "        p = gmpy2.next_prime(10**mag)\n",
        "        q = gmpy2.next_prime(p)\n",
        "        N = p * q\n",
        "        delta_sq = q**2 - p**2\n",
        "\n",
        "        # Erro de Taylor vs Erro Real\n",
        "        exact_root = gmpy2.sqrt(gmpy2.mpz(N**2 - delta_sq))\n",
        "        error = float(abs(N - exact_root))\n",
        "        curvature_term = delta_sq / (2 * N)\n",
        "\n",
        "        res_ratio = error / curvature_term if curvature_term != 0 else 0\n",
        "\n",
        "        results.append({\n",
        "            \"Mag\": mag,\n",
        "            \"Ratio\": res_ratio,\n",
        "            \"Dist_066\": abs(res_ratio - 0.666666),\n",
        "            \"Dist_1.0\": abs(res_ratio - 1.0)\n",
        "        })\n",
        "\n",
        "    df = pd.DataFrame(results)\n",
        "\n",
        "    plt.figure(figsize=(12, 6))\n",
        "    plt.plot(df[\"Mag\"], df[\"Ratio\"], 'b-o', label='Razão de Curvatura (Experimental)')\n",
        "    plt.axhline(y=0.666, color='red', linestyle='--', label='Atrator 2/3 (Resonância Baixa)')\n",
        "    plt.axhline(y=1.0, color='green', linestyle='-', label='Atrator 1.0 (Convergência Profunda)')\n",
        "\n",
        "    plt.fill_between(df[\"Mag\"], 0.666, 1.0, alpha=0.1, color='gray', label='Zona de Transição de Fase')\n",
        "\n",
        "    plt.title(\"O Vórtice de Taylor: Transição da Ressonância 0.666 para 1.0\")\n",
        "    plt.xlabel(\"Magnitude (Log10)\")\n",
        "    plt.ylabel(\"Razão de Erro Residual\")\n",
        "    plt.legend()\n",
        "    plt.grid(True, which='both', linestyle='--', alpha=0.5)\n",
        "    plt.show()\n",
        "\n",
        "    # Identificação do Ponto de Ruptura\n",
        "    break_node = df[df['Dist_1.0'] < df['Dist_066']].iloc[0]\n",
        "    print(f\"\\n>>> PONTO DE RUPTURA IDENTIFICADO: 10^{int(break_node['Mag'])}\")\n",
        "    print(f\"Neste ponto, a Geometria de Taylor assume o controle total sobre a Ressonância Rítmica.\")\n",
        "\n",
        "plot_resonance_landscape(1, 40)"
      ],
