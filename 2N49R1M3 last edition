        "import gmpy2\n",
        "import pandas as pd\n",
        "\n",
        "def simulate_base_transition(p_anchor, neighbors):\n",
        "    results = []\n",
        "    # Saturation threshold: p^2\n",
        "    threshold = p_anchor**2\n",
        "    print(f'Anchor: {p_anchor} | Saturation Threshold (p^2): {threshold}')\n",
        "\n",
        "    for q in neighbors:\n",
        "        N = p_anchor * q\n",
        "        dq = q**2 - p_anchor**2\n",
        "        dp = q - p_anchor\n",
        "        ratio = float(q) / float(p_anchor)\n",
        "\n",
        "        # Testing both polarities\n",
        "        # Positive vector: N + dq - dp\n",
        "        # Negative vector: N - dq - dp\n",
        "        v_pos = N + dq - dp\n",
        "        v_neg = N - dq - dp\n",
        "\n",
        "        results.append({\n",
        "            'q': q,\n",
        "            'Ratio_qp': round(ratio, 4),\n",
        "            'N': N,\n",
        "            'Above_Threshold': N > threshold,\n",
        "            'Pos_Vector': int(v_pos),\n",
        "            'Pos_Is_Prime': gmpy2.is_prime(int(v_pos)) if v_pos > 1 else False,\n",
        "            'Neg_Vector': int(v_neg),\n",
        "            'Neg_Is_Prime': gmpy2.is_prime(int(v_neg)) if v_neg > 1 else False\n",
        "        })\n",
        "\n",
        "    return pd.DataFrame(results)\n",
        "\n",
