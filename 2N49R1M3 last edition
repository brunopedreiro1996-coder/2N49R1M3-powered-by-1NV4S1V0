      "source": [
        "import gmpy2\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "def simulate_q_p_stress(mag=15, iterations=200):\n",
        "    p = gmpy2.next_prime(10**mag)\n",
        "    results = []\n",
        "\n",
        "    # Test various ratios by skipping primes to increase q\n",
        "    q = p\n",
        "    for i in range(iterations):\n",
        "        # Increase step to expand q/p ratio range\n",
        "        jump = 1 + (i // 5)\n",
        "        for _ in range(jump): q = int(gmpy2.next_prime(q))\n",
        "\n",
        "        N = p * q\n",
        "        dq = q**2 - p**2\n",
        "        dp = q - p\n",
        "        ratio = float(q) / float(p)\n",
        "\n",
        "        v_pos = N + dq - dp\n",
        "        v_neg = N - dq - dp\n",
        "\n",
        "        results.append({\n",
        "            'ratio': ratio,\n",
        "            'pos_hit': 1 if v_pos > 1 and gmpy2.is_prime(v_pos) else 0,\n",
        "            'neg_hit': 1 if v_neg > 1 and gmpy2.is_prime(v_neg) else 0\n",
        "        })\n",
        "\n",
        "    df = pd.DataFrame(results)\n",
        "    df['ratio_bin'] = pd.cut(df['ratio'], bins=[1, 1.5, 2.0, 2.5, 3.0, 4.0, 5.0, 10.0])\n",
        "\n",
        "    summary = df.groupby('ratio_bin', observed=True).agg({\n",
        "        'pos_hit': 'sum',\n",
        "        'neg_hit': 'sum',\n",
        "        'ratio': 'count'\n",
        "    }).rename(columns={'ratio': 'sample_size'})\n",
        "\n",
        "    print(f'--- Factor Stress Audit at 10^{mag} ---')\n",
        "    display(summary)\n",
        "    return summary\n",
        "\n",
        "stress_summary = simulate_q_p_stress(mag=15, iterations=250)"
      ],
