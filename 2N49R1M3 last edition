        "import gmpy2\n",
        "import pandas as pd\n",
        "\n",
        "def simulate_calibrated_jump(magnitudes, iterations=100):\n",
        "    ratios = [1.666666666, 2.618033988]\n",
        "    results = []\n",
        "\n",
        "    for mag in magnitudes:\n",
        "        print(f'Simulating Magnitude 10^{mag}...')\n",
        "        p = gmpy2.next_prime(10**mag)\n",
        "        pos_hits = 0\n",
        "        neg_hits = 0\n",
        "\n",
        "        for _ in range(iterations):\n",
        "            for ratio in ratios:\n",
        "                q_target = int(p * ratio)\n",
        "                q = gmpy2.next_prime(q_target)\n",
        "                N = p * q\n",
        "                dq = q**2 - p**2\n",
        "                dp = q - p\n",
        "                stress = float(q) / float(p)\n",
        "\n",
        "                # Positive Polarity Vector\n",
        "                v_pos = N + dq - dp\n",
        "                if v_pos > 1 and gmpy2.is_prime(v_pos):\n",
        "                    pos_hits += 1\n",
        "\n",
        "                # Negative Polarity Vector (subject to stress threshold <= 2.0)\n",
        "                if stress <= 2.0:\n",
        "                    v_neg = N - dq - dp\n",
        "                    if v_neg > 1 and gmpy2.is_prime(v_neg):\n",
        "                        neg_hits += 1\n",
        "\n",
        "            # Advance p to a new region\n",
        "            p = gmpy2.next_prime(p + (p // 30))\n",
        "\n",
        "        results.append({\n",
        "            'Magnitude': f'10^{mag}',\n",
        "            'Samples': iterations * 2,\n",
        "            'Positive_Hits': pos_hits,\n",
        "            'Negative_Hits': neg_hits,\n",
        "            'Total_Elite_Hits': pos_hits + neg_hits\n",
        "        })\n",
