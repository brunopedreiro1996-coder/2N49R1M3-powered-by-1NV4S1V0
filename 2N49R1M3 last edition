        "        std::vector<int> mags; std::vector<double> weights;\n",
        "        for(auto const& [m, w] : mag_weights) {\n",
        "            if (!seed_bins[m].empty()) { mags.push_back(m); weights.push_back(w); }\n",
        "        }\n",
        "        if (weights.empty()) return mpz_class(233);\n",
        "        std::discrete_distribution<int> dist(weights.begin(), weights.end());\n",
        "        int idx = dist(gen);\n",
        "        auto& bin = seed_bins[mags[idx]];\n",
        "        return bin[gen() % bin.size()];\n",
        "    }\n",
        "\n",
        "    // Reverted to probabilistic Pocklington-lite\n",
        "    bool pocklington_lite(const mpz_class& N, const mpz_class& F_anchor_param) {\n",
        "        // F_anchor_param is kept for signature compatibility but not used in probabilistic test\n",
        "        if (N < 2) return false;\n",
        "        return (mpz_probab_prime_p(N.get_mpz_t(), 25) > 0);\n",
        "    }\n",
        "\n",
        "    void record_hit(const mpz_class& cand, std::string type, const mpz_class& parent, const mpz_class& F) {\n",
        "        std::string sv = cand.get_str(); int mag = sv.length();\n",
        "        std::lock_guard<std::mutex> lock(mtx);\n",
        "        if (registry.find(sv) == registry.end()) {\n",
        "            mpz_class snap_cand = cand + 2;\n",
        "            // Use pocklington_lite for twin prime check\n",
        "            if (pocklington_lite(snap_cand, F)) type += \"_snap\";\n",
        "            else if (mag > 500) type += \"_inv4s1v0\";\n",
        "            registry.insert(sv); seed_bins[mag].push_back(cand); mag_weights[mag] += 5.0;\n",
        "            logs.push_back({{\"v\", sv}, {\"type\", type}, {\"mag\", mag}, {\"parent\", parent.get_str()}, {\"F\", F.get_str()}});\n",
        "            std::cout << \"[ELITE HIT] \" << type << \" | Mag: \" << mag << \" | Node: \" << sv.substr(0,10) << \"...\" << std::endl;\n",
        "        }\n",
        "    }\n",
        "\n",
        "public:\n",
        "    AdaptiveEngine2N49R1M3() { load_memory(); }\n",
        "\n",
        "    void run_cycle() {\n",
        "        std::mt19937 gen(std::random_device{}());\n",
        "        std::uniform_real_distribution<> dis(0.0, 1.0);\n",
        "        while (keep_running) {\n",
        "            mpz_class p = get_adaptive_seed(gen);\n",
        "            int p_mag = p.get_str().length();\n",
        "\n",
        "            mpz_class anchor, F_anchor_for_generation; std::string type; double r = dis(gen);\n",
        "\n",
        "            if (!mirror_deltas.empty() && r < 0.3) {\n",
        "                mpz_class delta = mirror_deltas[gen() % mirror_deltas.size()];\n",
        "                for (int side : {1, -1}) {\n",
        "                    anchor = p + (delta * side); F_anchor_for_generation = delta; type = (side > 0) ? \"mirror_pos\" : \"mirror_neg\";\n",
        "                    if (anchor > 1 && ked_sync_filter(anchor, F_anchor_for_generation) && pocklington_lite(anchor, F_anchor_for_generation)) record_hit(anchor, type, p, F_anchor_for_generation);\n",
        "                }\n",
        "            } else if (r < 0.5) { // Symbiotic\n",
        "                mpz_class q = get_adaptive_seed(gen);\n",
        "                anchor = p * q; F_anchor_for_generation = (p > q) ? p : q; type = \"symbiotic_p*q\";\n",
        "            } else { // Dynamic Harmonic Pivot\n",
        "                HarmonicStrategy strategy_params = get_harmonic_pivot_strategy(p_mag, gen);\n",
        "                unsigned long E = get_random_E(strategy_params.min_E_range, strategy_params.max_E_range, gen);\n",
        "\n",
        "                mpz_class base_mpz(strategy_params.base_val);\n",
        "                mpz_pow_ui(F_anchor_for_generation.get_mpz_t(), base_mpz.get_mpz_t(), E);\n",
        "\n",
        "                anchor = p * F_anchor_for_generation;\n",
        "                type = strategy_params.type_suffix;\n",
        "            }\n",
        "\n",
        "            // Law 30k application\n",
        "            mpz_class base_30 = (anchor / 30) * 30;\n",
        "            for (int i = -1; i <= 1 && keep_running; ++i) {\n",
        "                for (int res : {1, -1, 7, 11, 13, 17, 19, 23, 29}) {\n",
        "                    mpz_class c = base_30 + (i * 30) + res;\n",
        "                    if (c > 1 && ked_sync_filter(c, F_anchor_for_generation) && pocklington_lite(c, F_anchor_for_generation)) record_hit(c, type, p, F_anchor_for_generation);\n",
        "                }\n",
        "            }\n",
        "            if (gen() % 100 == 0) save_memory();\n",
        "        }\n",
        "        save_memory();\n",
        "    }\n",
        "\n",
        "    void start() {\n",
        "        int n = std::thread::hardware_concurrency();\n",
        "        std::cout << \"[SYSTEM] Motor 2N49R1M3 Ativo | Threads: \" << n << std::endl;\n",
        "        std::vector<std::thread> threads;\n",
        "        for (int i = 0; i < n; ++i) threads.emplace_back(&AdaptiveEngine2N49R1M3::run_cycle, this);\n",
        "        for (auto& t : threads) t.join();\n",
        "    }\n",
        "};\n",
        "\n",
