        "import gmpy2\n",
        "import pandas as pd\n",
        "\n",
        "def scan_identity_thresholds(start_p, iterations=50):\n",
        "    results = []\n",
        "    p = gmpy2.next_prime(start_p)\n",
        "\n",
        "    for _ in range(iterations):\n",
        "        q = gmpy2.next_prime(p)\n",
        "        N = p * q\n",
        "        dq = q**2 - p**2\n",
        "        dp = q - p\n",
        "        ratio = float(q**2) / float(p**2)\n",
        "\n",
        "        cand = N + dq - dp\n",
        "        is_p = gmpy2.is_prime(int(cand))\n",
        "\n",
        "        if is_p:\n",
        "            results.append({\n",
        "                \"p\": int(p),\n",
        "                \"q\": int(q),\n",
        "                \"Ratio_q2_p2\": round(ratio, 4),\n",
        "                \"Prime_Found\": int(cand)\n",
        "            })\n",
        "        p = q\n",
        "\n",
        "    df = pd.DataFrame(results)\n",
        "    print(f\"--- Relat&oacute;rio de Sucesso da Hip&oacute;tese (N + Δq - Δp) ---\")\n",
        "    if not df.empty:\n",
        "        display(df)\n",
        "        print(f\"\\nTaxa de acerto: {len(df)}/{iterations} ({len(df)/iterations*100:.1f}%)\")\n",
        "        print(f\"M&eacute;dia da Raz&atilde;o de Diverg&ecirc;ncia nos Hits: {df['Ratio_q2_p2'].mean():.4f}\")\n",
        "    else:\n",
        "        print(\"Nenhum hit encontrado nesta faixa.\")\n",
