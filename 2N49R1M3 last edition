        "\n",
        "    success_rate = df_frag[(df_frag['Pos_Is_Prime']) | (df_frag['Neg_Is_Prime'])].shape[0] / len(df_frag) * 100\n",
        "    print(f'\\nTaxa de Descoberta na Transição: {success_rate:.1f}%')\n",
        "    return df_frag\n",
