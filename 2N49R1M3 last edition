      "source": [
        "import gmpy2\n",
        "import pandas as pd\n",
        "\n",
        "def simulate_vertical_scaling(magnitudes, iterations=100):\n",
        "    ratios = {'2/3_Resonance': 1.666666666, 'Golden_Vortex': 2.618033988}\n",
        "    scaling_results = []\n",
        "\n",
        "    for mag in magnitudes:\n",
        "        print(f'Testing Magnitude: 10^{mag}...')\n",
        "        for name, ratio in ratios.items():\n",
        "            hits = 0\n",
        "            ked_sum = 0\n",
        "            p = gmpy2.next_prime(10**mag)\n",
        "\n",
        "            for _ in range(iterations):\n",
        "                q_target = int(p * ratio)\n",
        "                q = gmpy2.next_prime(q_target)\n",
        "                N = p * q\n",
        "                dq = q**2 - p**2\n",
        "                dl = q - p\n",
        "                cand = N + dq - dl\n",
        "\n",
        "                if gmpy2.is_prime(cand):\n",
        "                    hits += 1\n",
        "                    ked_sum += gmpy2.bit_scan1(cand - 1)\n",
        "\n",
        "                # Shift seed for variety\n",
        "                p = gmpy2.next_prime(p + (p // 20))\n",
        "\n",
        "            scaling_results.append({\n",
        "                'Magnitude': f'10^{mag}',\n",
        "                'Corridor': name,\n",
        "                'Success_Rate (%)': (hits / iterations) * 100,\n",
        "                'Avg_KED_Clarity': (ked_sum / hits) if hits > 0 else 0\n",
        "            })\n",
        "\n",
        "    return pd.DataFrame(scaling_results)\n",
        "\n",
        "# Simulating the requested magnitudes\n",
        "df_scaling = simulate_vertical_scaling([15, 30, 60], iterations=50)\n",
        "display(df_scaling)"
