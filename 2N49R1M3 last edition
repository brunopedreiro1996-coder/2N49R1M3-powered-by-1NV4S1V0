        "import gmpy2\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "def analyze_phi_resonance(p_start, iterations=200):\n",
        "    results = []\n",
        "    phi = (1 + 5**0.5) / 2\n",
        "    p = gmpy2.next_prime(p_start)\n",
        "\n",
        "    for _ in range(iterations):\n",
        "        q = gmpy2.next_prime(p)\n",
        "        N = p * q\n",
        "        # Testando a f&oacute;rmula de sucesso anterior: P = N + (q&sup2;-p&sup2;) - (q-p)\n",
        "        cand = N + (q**2 - p**2) - (q - p)\n",
        "\n",
        "        if gmpy2.is_prime(int(cand)):\n",
        "            ratio = float(q) / float(p)\n",
        "            results.append({\n",
        "                \"p\": int(p),\n",
        "                \"q\": int(q),\n",
        "                \"Ratio_qp\": ratio,\n",
        "                \"Dist_Phi\": abs(ratio - phi),\n",
        "                \"Dist_2/3\": abs(ratio - (2/3 + 1)) # Ajustado para escala q > p\n",
        "            })\n",
        "        p = q\n",
        "\n",
        "    df_phi = pd.DataFrame(results)\n",
        "    if not df_phi.empty:\n",
        "        print(f\"--- Hits vs Geometria de Fatores ---\")\n",
        "        display(df_phi)\n",
        "        print(f\"\\nProximidade M&eacute;dia de Phi: {df_phi['Dist_Phi'].mean():.4f}\")\n",
        "        print(f\"Correla&ccedil;&atilde;o entre Hits e Phi: {df_phi['Ratio_qp'].std():.4f}\")\n",
        "    else:\n",
        "        print(\"Nenhum hit para an&aacute;lise de raz&atilde;o.\")\n",
        "\n",
        "analyze_phi_resonance(1000, 300)"
