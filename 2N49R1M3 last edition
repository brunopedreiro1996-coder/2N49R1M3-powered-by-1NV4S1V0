      "source": [
        "import gmpy2\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "def map_dynamic_polarity(p_range, neighbors_count=100):\n",
        "    mapping_data = []\n",
        "\n",
        "    for p in p_range:\n",
        "        p = int(gmpy2.next_prime(p))\n",
        "        q = p\n",
        "        for _ in range(neighbors_count):\n",
        "            q = int(gmpy2.next_prime(q))\n",
        "            N = p * q\n",
        "            dq = q**2 - p**2\n",
        "            dp = q - p\n",
        "            ratio = q / p\n",
        "\n",
        "            v_pos = N + dq - dp\n",
        "            v_neg = N - dq - dp\n",
        "\n",
        "            mapping_data.append({\n",
        "                'p': p,\n",
        "                'ratio': ratio,\n",
        "                'pos_hit': 1 if v_pos > 1 and gmpy2.is_prime(v_pos) else 0,\n",
        "                'neg_hit': 1 if v_neg > 1 and gmpy2.is_prime(v_neg) else 0\n",
        "            })\n",
        "\n",
        "    df = pd.DataFrame(mapping_data)\n",
        "\n",
        "    # Binning ratios to see the density shift\n",
        "    df['ratio_bin'] = pd.cut(df['ratio'], bins=np.linspace(1, 10, 19))\n",
        "    summary = df.groupby('ratio_bin', observed=True).agg({\n",
        "        'pos_hit': 'sum',\n",
        "        'neg_hit': 'sum'\n",
        "    })\n",
        "\n",
        "    print(\"--- Polarity Success Mapping by Stress Ratio (q/p) ---\")\n",
        "    display(summary)\n",
        "\n",
        "    return df, summary\n",
        "\n",
        "# Scanning anchors p=7, 13, 17, 19, 23 to capture different mesh densities\n",
        "p_seeds = [7, 13, 17, 19, 23]\n",
        "df_pol_map, summary_pol = map_dynamic_polarity(p_seeds, neighbors_count=150)"
      ],
