        "outputId": "c1931649-a9f5-463b-c47d-b8cc5b04729d"
      },
      "source": [
        "def search_decimal_ghost_666(start_mag, end_mag, iterations=20):\n",
        "    import gmpy2\n",
        "    import pandas as pd\n",
        "    from gmpy2 import mpfr, context\n",
        "\n",
        "    results = []\n",
        "    print(f\"Buscando fantasmas decimais '666' entre 10^{start_mag} e 10^{end_mag}...\")\n",
        "\n",
        "    # Ajustando contexto de precisão para cálculos decimais profundos\n",
        "    with context(precision=1000):\n",
