        "    q = p_base\n",
        "    for _ in range(neighbors_count):\n",
        "        q = int(gmpy2.next_prime(q))\n",
        "        N = p_base * q\n",
        "        dq = q**2 - p_base**2\n",
        "        dp = q - p_base\n",
        "\n",
        "        # Candidatos Híbridos\n",
        "        v_pos = N + dq - p_base\n",
