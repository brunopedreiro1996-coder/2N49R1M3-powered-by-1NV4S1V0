        "import pandas as pd\n",
        "import numpy as np\n",
        "\n",
        "def audit_factor_density(x_start, window_size=1000):\n",
        "    x_end = x_start**2\n",
        "    # Limiting the simulation range for performance, focusing on the first 100k numbers\n",
        "    sim_range = min(x_end, x_start + 100000)\n",
