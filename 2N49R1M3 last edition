        "            'N': N,\n",
        "            'Status_N': 'FRAGMENTADO (N > p²)' if N > saturation else 'ESTÁVEL',\n",
        "            'Proximo_Ciclo': 'SIM (N >= p*3)' if N >= restart_base else 'NÃO',\n",
        "            'Pos_Vortex': int(v_pos),\n",
        "            'Pos_Is_Prime': gmpy2.is_prime(int(v_pos)) if v_pos > 1 else False,\n",
