        "### 7.19. Busca por Identidade Exata nos Vetores de Polaridade\n",
        "\n",
        "Nesta refatoração, vamos iterar sobre magnitudes elevadas para verificar se a coincidência $P^2 = N^2 \\pm \\Delta_{sq} \\pm \\Delta_{lin}$ ocorre em algum ponto do campo numérico profundo. Isso validaria a existência de 'pontos de ressonância perfeita' no vórtice."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "f9572e98",
        "outputId": "e95f93ce-a9a1-4ba9-ac27-c47c2951d423"
      },
      "source": [
        "def search_exact_polarity_identity(iterations, magnitude_start=10):\n",
        "    import gmpy2\n",
        "    import pandas as pd\n",
        "\n",
        "    results = []\n",
        "    p = gmpy2.next_prime(10**magnitude_start)\n",
        "\n",
        "    print(f\"Iniciando busca por identidade exata a partir de 10^{magnitude_start}...\")\n",
        "\n",
        "    for _ in range(iterations):\n",
        "        q = gmpy2.next_prime(p)\n",
        "        N = p * q\n",
        "        delta_lin = q - p\n",
        "        delta_sq = q**2 - p**2\n",
        "        N_sq = N**2\n",
        "\n",
        "        # Alvos lineares (P = N ± Δlin)\n",
        "        targets = {\n",
        "            \"P_pos²\": (N + delta_lin)**2,\n",
        "            \"P_neg²\": (N - delta_lin)**2\n",
        "        }\n",
        "\n",
        "        found_identity = False\n",
        "\n",
        "        # Testando as 4 combinações de vetores quadráticos\n",
        "        for s1 in [1, -1]:\n",
        "            for s2 in [1, -1]:\n",
        "                vector_val = N_sq + (s1 * delta_sq) + (s2 * delta_lin)\n",
        "\n",
        "                for name, target_val in targets.items():\n",
        "                    if vector_val == target_val:\n",
        "                        results.append({\n",
        "                            \"Fatores\": f\"({p}, {q})\",\n",
        "                            \"Target\": name,\n",
        "                            \"Vetor\": f\"N² {'+' if s1>0 else '-'} Δsq {'+' if s2>0 else '-'} Δlin\",\n",
        "                            \"Status\": \"MATCH PERFEITO\"\n",
        "                        })\n",
        "                        found_identity = True\n",
        "\n",
        "        if not found_identity and _ % (iterations // 5 if iterations >= 5 else 1) == 0:\n",
        "             # Log de progresso com erro mínimo encontrado na rodada\n",
        "             min_err = abs((N_sq + delta_sq + delta_lin) - targets[\"P_pos²\"])\n",
        "             print(f\"Magnitudo {len(str(N))}: Menor Salto = {min_err}\")\n",
        "\n",
        "        p = gmpy2.next_prime(q)\n",
        "\n",
        "    if results:\n",
        "        display(pd.DataFrame(results))\n",
        "    else:\n",
        "        print(\"\\nNenhuma identidade exata encontrada. O 'salto numérico' permanece como um resíduo de curvatura.\")\n",
        "\n",
        "search_exact_polarity_identity(iterations=10, magnitude_start=20)"
      ],
