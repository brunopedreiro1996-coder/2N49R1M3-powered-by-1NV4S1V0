        "### 7.21. Auditoria de Proximidade nos Vetores de Polaridade\n",
        "\n",
        "Refatoração para identificar primos na vizinhança dos 4 vetores de polaridade calculados. Vamos observar se o 'Salto Numérico' nos posiciona perto de primos reais e quais são as distâncias rítmicas ($d = |\\text{Vetor} - \\text{Primo}|$)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 441
        },
        "id": "0e79498c",
        "outputId": "43bfc487-e580-4709-85ca-ab16298c8bb7"
      },
      "source": [
        "def analyze_polarity_neighborhood(iterations, magnitude_start=15, search_radius=100):\n",
        "    import gmpy2\n",
        "    import pandas as pd\n",
        "\n",
        "    results = []\n",
        "    p = gmpy2.next_prime(10**magnitude_start)\n",
        "\n",
        "    print(f\"Analisando vizinhança dos vetores a partir de 10^{magnitude_start} (Raio: {search_radius})...\")\n",
        "\n",
        "    for _ in range(iterations):\n",
        "        q = gmpy2.next_prime(p)\n",
        "        N = p * q\n",
        "        delta_lin = q - p\n",
        "        delta_sq = q**2 - p**2\n",
        "        N_sq = N**2\n",
        "\n",
        "        # Gerar os 4 vetores de polaridade do Vórtice\n",
        "        combinations = []\n",
        "        for s1 in [1, -1]:\n",
        "            for s2 in [1, -1]:\n",
        "                val = N_sq + (s1 * delta_sq) + (s2 * delta_lin)\n",
        "                s1_str = '+' if s1 > 0 else '-'\n",
        "                s2_str = '+' if s2 > 0 else '-'\n",
        "                label = f\"N² {s1_str} Δsq {s2_str} Δlin\"\n",
        "                combinations.append({\"val\": val, \"label\": label})\n",
        "\n",
        "        for combo in combinations:\n",
        "            base_val = combo[\"val\"]\n",
        "            # Busca radial por primos ao redor do vetor\n",
        "            for dist in range(0, search_radius + 1):\n",
        "                for side in [1, -1]:\n",
        "                    if dist == 0 and side == -1: continue\n",
        "                    cand = base_val + (dist * side)\n",
        "\n",
        "                    if gmpy2.is_prime(cand):\n",
        "                        results.append({\n",
        "                            \"N_Mag\": len(str(N)),\n",
        "                            \"Vetor\": combo[\"label\"],\n",
        "                            \"Distância\": dist * side,\n",
        "                            \"Primo_Encontrado\": str(cand)[:15] + \"...\",\n",
        "                            \"Status\": \"HIT DIRETO\" if dist == 0 else \"PROXIMIDADE\"\n",
        "                        })\n",
        "\n",
        "        p = gmpy2.next_prime(q)\n",
        "\n",
        "    if results:\n",
        "        display(pd.DataFrame(results))\n",
        "    else:\n",
        "        print(\"Nenhum primo encontrado na vizinhança imediata dos vetores para este intervalo.\")\n",
        "\n",
        "analyze_polarity_neighborhood(iterations=5, magnitude_start=15, search_radius=200)"
      ],
